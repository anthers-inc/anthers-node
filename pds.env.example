# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Configuration for an Anthers creator node. Copy to /pds/pds.env and fill in.
#
# 🚨 **Every value below marked GENERATED must be generated on the machine, never typed and
# never copied from anywhere.** `scripts/setup.sh` writes them. The placeholders here are
# deliberately not secret-shaped so that this file cannot be mistaken for a real one, by a
# person or by a secret scanner.
#
# ⭐ **The tenancy dial is four variables and nothing else.** Anthers running this server for
# many people and a creator running it for themselves differ in `PDS_SERVICE_HANDLE_DOMAINS`,
# `PDS_INVITE_REQUIRED`, the email block, and whether the `unattended` compose profile is
# used. There is no second image and no second compose file; that is what "one artifact at
# two settings" means, and it is checkable here rather than merely asserted.

# ─── Identity of this server ───

# The domain this server answers on, and the suffix its handles hang under.
# 🚨 For Anthers this is `anthers.social` and must NEVER be a subdomain of `anthers.org`.
# The session cookie is issued with `Domain=.anthers.org`, so a browser sends it to every
# subdomain — and issuing user-controlled names inside that boundary would hand each holder
# a place the browser is willing to send somebody's session.
PDS_HOSTNAME=node.example.invalid

# Where the operator can be reached. The server reports this in its own description, so
# treat it as public. ⚠️ It is `PDS_CONTACT_EMAIL_ADDRESS` and not `PDS_ADMIN_EMAIL` — the
# latter belongs to the upstream installer, which this bundle does not use, and setting it
# here would be a line that looks like configuration and is read by nothing.
PDS_CONTACT_EMAIL_ADDRESS=you@example.invalid

# ─── GENERATED: never type these ───

# 🚨 The rotation key is the one that matters. It is the key that can rewrite this server's
# identity documents, and there is no way to reissue it from anything else — so it is both
# the most valuable string on the machine and the one most easily lost by reinstalling.
PDS_JWT_SECRET=GENERATED-BY-SETUP-SCRIPT
PDS_ADMIN_PASSWORD=GENERATED-BY-SETUP-SCRIPT
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX=GENERATED-BY-SETUP-SCRIPT

# ─── The offline recovery key ───

# ⭐ **A second rotation key, held somewhere this machine cannot reach, ranked above the
# server's own.** An identity carries an ordered list of rotation keys and a higher one can
# clobber operations signed by a lower one within a 72-hour window — so this is what answers
# the compromise of the key directly above, which necessarily lives in this file on an
# internet-facing machine.
#
# 🚨 **Only the PUBLIC half goes here, and `setup.sh` deliberately does not generate it.**
# A key this machine generated is a key this machine has held, which is the entire property
# being bought. Run `scripts/generate-recovery-key.sh` somewhere else — a laptop, not this
# box — keep the private half offline, and paste only the `did:key:` form below.
#
# This follows the pattern Bluesky runs in production, where every account carries two
# server-held rotation keys in a fixed order. Anthers departs from them in the other
# direction: a creator whose identity Anthers hosts is issued a key of their own, ranked
# ABOVE both of these, passed as `recoveryKey` at account creation. That key is the whole
# custody promise, and it is unaffected by whether this one is set.
#
# Leave unset on a node with a single account whose owner already holds the file above.
# PDS_RECOVERY_DID_KEY=did:key:PASTE-THE-PUBLIC-HALF-HERE

# ─── Storage ───

PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT=314572800

# ─── The rest of the network ───

PDS_DID_PLC_URL=https://plc.directory
PDS_BSKY_APP_VIEW_URL=https://api.bsky.app
PDS_BSKY_APP_VIEW_DID=did:web:api.bsky.app
PDS_REPORT_SERVICE_URL=https://mod.bsky.app
PDS_REPORT_SERVICE_DID=did:plc:ar7c4by46qjdydhdevvrndac

# 🛑 **Empty on purpose, and this is the deliberate deviation from the upstream installer,
# which ships `https://bsky.network` here.** This variable is the act of asking the network
# to come and read this server. Until it is set, accounts on this machine work perfectly
# well and nothing else on the network knows they exist; setting it puts every account here
# onto the public network at once, on the same footing as making a source repository public.
# That is a decision made once, deliberately, and announced — not a line filled in while
# copying a config.
PDS_CRAWLERS=

# ─── The tenancy dial ───

# The suffix handles are issued under. Defaults to PDS_HOSTNAME when unset, which is the
# right answer for a creator running one for themselves.
# Anthers, running this for many people, sets `.anthers.social`.
# PDS_SERVICE_HANDLE_DOMAINS=.anthers.social

# A creator running a node for themselves has nobody to gate, and turning this off saves
# them generating an invite to create their own account. Anthers running it for many people
# leaves it `true`.
PDS_INVITE_REQUIRED=true

# Account email — confirmations, password resets, moderation contact. Required at the many-
# person setting and pointless at the one-person setting, where the only account holder is
# the person who owns the box.
# PDS_EMAIL_SMTP_URL=smtps://USER:PASSWORD@smtp.example.invalid:465
# PDS_EMAIL_FROM_ADDRESS=noreply@example.invalid

# ─── Operations ───

LOG_ENABLED=true
PDS_RATE_LIMITS_ENABLED=true

# ─── Backup ───
#
# 🚨 A credential scoped to write backups and NOTHING else. If this server ever gains a
# serving credential for the same object store, it must be a different key with a different
# grant — a leaked serving key that can also reach the backups turns a recoverable incident
# into an unrecoverable one, and the split cannot be retrofitted afterwards.
NODE_BACKUP_BUCKET=your-backup-bucket
# Two prefixes are derived from this one: `<prefix>` holds the database replication, and
# `<prefix>-keys` holds the account signing keys. They must not share a tree — Litestream
# replicates a database into a *directory* named after it, so keys written alongside would
# interleave with the replication segments and put a directory exactly where the restored
# `store.sqlite` file has to go.
NODE_BACKUP_PREFIX=pds
NODE_BACKUP_ENDPOINT=https://your-account.r2.cloudflarestorage.com
NODE_BACKUP_REGION=auto
NODE_BACKUP_ACCESS_KEY_ID=GENERATED-BY-YOUR-OBJECT-STORE
NODE_BACKUP_SECRET_ACCESS_KEY=GENERATED-BY-YOUR-OBJECT-STORE
